{
  "expo": {
    "name": "헤어패스",
    "slug": "hairpass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/HairPass_icon.png",
    "scheme": "hairpass",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/HairPass_icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#016bfc"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zelon.hairpass",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.zelon.hairpass",
      "adaptiveIcon": {
        "backgroundColor": "#016bfc",
        "foregroundImage": "./assets/images/HairPass_icon.png",
        "monochromeImage": "./assets/images/HairPass_icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/HairPass_icon.png",
          "color": "#016bfc"
        }
      ],
      "@preeternal/react-native-cookie-manager"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6d9c9f47-dc56-4845-8d49-e68ba8f985fd"
      }
    }
  }
}
